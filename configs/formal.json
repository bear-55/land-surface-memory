    "static_missing_indicators": [
      "geol_porosity"
    ]
  },
  "training": {
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 1e-05,
    "grad_clip_norm": 1.0,
    "batch_size": 64,
    "max_epochs": 30,
