{
  "model": {
    "models": {
      "B0": "none",
      "M1": "conditional",
      "A1": "shared"
    },
    "layers": 1,
    "hidden_size": 64,
    "rank": 4,
    "seq_length": 365,
    "output_dropout": 0.2,
    "output_head": "softplus",
    "initial_state": "zero_per_window",
    "adapter_U_init": "zeros",
