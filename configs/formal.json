      11,
      29,
      47,
      65,
      83,
      103,
      119,
      137,
      155,
      173
    ],
    "sampling": "uniform_basin_then_uniform_valid_window_with_replacement",
    "share_batch_indices_across_models": true,
    "windows_per_epoch": "total_valid_training_windows",
    "loss": "mean_squared_error_divided_by_source_sigma_plus_epsilon_squared",
    "epsilon_mm_day": 0.1,
    "q_ref": "max_median_source_training_basin_mean_q_or_0.1",
    "sigma_ddof": 0
